  <version>0.1.0</version>
  <description>The S1 course: a Gazebo Harmonic world generated from one YAML description</description>
  <maintainer email="ben.m.ross08@gmail.com">Ben Ross</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
